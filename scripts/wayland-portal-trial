#!/usr/bin/env bash
# Reversible user-session trial of Hyprland's consent-capable RemoteDesktop PR.
set -euo pipefail

revision=0204ffbbcb3cef72af76804cdf59f114f2e2f6d9
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
trial_dir=${XDG_DATA_HOME:-$HOME/.local/share}/ukvm/portal-trial
unit_dir=$config_dir/systemd/user
legacy_dir=$runtime_dir/ukvm-xdph-trial
storage=persistent
legacy_present() {
    local path
    for path in "$legacy_dir" \
        "$runtime_dir/systemd/user/xdg-desktop-portal.service.d/ukvm-trial.conf" \
        "$runtime_dir/systemd/user/xdg-desktop-portal-hyprland.service.d/ukvm-trial.conf"; do
        [[ ! -e $path && ! -L $path ]] || return 0
    done
    return 1
}
if [[ ${1:-} != start && ! -e $trial_dir && ! -L $trial_dir ]] && legacy_present; then
    trial_dir=$legacy_dir
    unit_dir=$runtime_dir/systemd/user
    storage=legacy-runtime
fi
frontend_override=$unit_dir/xdg-desktop-portal.service.d/ukvm-trial.conf
backend_override=$unit_dir/xdg-desktop-portal-hyprland.service.d/ukvm-trial.conf
units=(xdg-desktop-portal-hyprland.service xdg-desktop-portal.service)
helper=${UKVM_TRIAL_HELPER:-$(dirname "$(realpath "$0")")/../target/debug/ukvm-portal-trial-session}

clear_failures() {
    local unit state
    for unit in "${units[@]}"; do
        state=$(systemctl --user show --property=ActiveState --value "$unit") || return 1
        # Las unidades D-Bus estáticas pueden descargarse al detenerlas; no hay fallo que borrar.
        if [[ $state == failed ]]; then
            systemctl --user reset-failed "$unit" || return 1
        fi
    done
}

portals_active() {
    local unit
    for unit in "${units[@]}"; do
        systemctl --user is-active --quiet "$unit" || return 1
    done
}

owned_trial() {
    [[ -d $trial_dir && ! -L $trial_dir && -f $trial_dir/owned-by-ukvm-trial && ! -L $trial_dir/owned-by-ukvm-trial ]] &&
        [[ $(cat "$trial_dir/owned-by-ukvm-trial") == "$revision" ]] || {
        printf 'No valid UKVM trial ownership marker; refusing to remove unrelated overrides.\n' >&2
        return 1
    }
    local path expected role helper_exec
    helper_exec=$(unit_path "$trial_dir/session-helper") || return 1
    for role in frontend backend; do
        if [[ $role == frontend ]]; then path=$frontend_override; else path=$backend_override; fi
        [[ -e $path || -L $path ]] || continue
        [[ -f $path && ! -L $path ]] || return 1
        expected=$trial_dir/$role.conf
        if [[ -e $expected || -L $expected ]]; then
            [[ -f $expected && ! -L $expected ]] || return 1
            cmp -s "$expected" "$path" || {
                printf 'Trial override was modified; refusing to remove %s\n' "$path" >&2
                return 1
            }
        elif [[ -e $trial_dir/state ]] || ! grep -Fq -- "ExecStart=:$helper_exec $role " "$path"; then
            printf 'Unrecognized legacy override; refusing to remove %s\n' "$path" >&2
            return 1
        fi
    done
}

restore_portals() {
    owned_trial || return 1
    printf 'restoring\n' > "$trial_dir/state" || return 1
    # Intentar ambos reinicios aunque uno falle; conservar los datos de recuperación si no arrancan.
    local failed=0 restore_helper=$helper
    if [[ $storage == persistent && -x $trial_dir/session-helper ]]; then
        restore_helper=$trial_dir/session-helper
    fi
    systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-hyprland.service || failed=1
    rm -f "$frontend_override" "$backend_override" || return 1
    systemctl --user daemon-reload || return 1
    if [[ -x $restore_helper ]]; then
        "$restore_helper" prepare-environment || failed=1
    fi
    clear_failures || failed=1
    systemctl --user restart xdg-desktop-portal-hyprland.service || failed=1
    systemctl --user restart xdg-desktop-portal.service || failed=1
    portals_active || failed=1
    if (( failed )); then
        printf 'broken\n' > "$trial_dir/state"
        printf 'Portal restoration failed; recovery marker retained. Inspect status/journal and retry stop.\n' >&2
        return 1
    fi
    rm -f "$trial_dir/portals/"*.portal "$trial_dir/portals/"*portals.conf \
        "$trial_dir/session-helper" "$trial_dir/xdg-desktop-portal-hyprland" \
        "$trial_dir/hyprland-share-picker" "$trial_dir/frontend.conf" "$trial_dir/backend.conf" || return 1
    rmdir "$trial_dir/portals" || return 1
    rm -f "$trial_dir/state" "$trial_dir/owned-by-ukvm-trial" || return 1
    rmdir "$trial_dir" || return 1
    rmdir "$(dirname "$frontend_override")" "$(dirname "$backend_override")" 2>/dev/null || true
    printf 'Packaged portal services restored and active. Verify with ukvm doctor.\n'
}

rollback_start() {
    local result=$?
    trap - EXIT HUP INT TERM
    if (( result != 0 )); then
        printf 'Trial setup failed; restoring packaged portals.\n' >&2
        if ! restore_portals; then
            printf 'Automatic restoration did not complete; trial status contains recovery details.\n' >&2
        fi
    fi
    exit "$result"
}

unit_path() {
    local value=$1
    [[ $value != *[$'\001'-$'\037'$'\177']* ]] || {
        printf 'Control characters are not allowed in trial paths.\n' >&2
        return 1
    }
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    printf '"%s"' "${value//%/%%}"
}

usage() {
    printf 'Usage: %s start SOURCE_DIR BUILD_DIR | stop | status\n' "$0" >&2
    exit 2
}

case ${1:-} in
    start)
        [[ $# == 3 ]] || usage
        source_dir=$(realpath "$2")
        build_dir=$(realpath "$3")
        [[ -x $helper && -x /usr/lib/xdg-desktop-portal ]] || {
            printf 'Run cargo build --workspace first; trial session helper or portal frontend is missing.\n' >&2
            exit 1
        }
        [[ $(git -C "$source_dir" rev-parse HEAD) == "$revision" ]] || {
            printf 'Wrong upstream revision. Expected %s\n' "$revision" >&2
            exit 1
        }
        [[ -x $build_dir/xdg-desktop-portal-hyprland && -x $build_dir/hyprland-share-picker/hyprland-share-picker ]] || {
            printf 'Build both the portal backend and consent picker first.\n' >&2
            exit 1
        }
        [[ -f $source_dir/hyprland.portal ]] || {
            printf 'Pinned source is missing hyprland.portal.\n' >&2
            exit 1
        }
        [[ ! -e $trial_dir && ! -L $trial_dir && ! -e $frontend_override && ! -L $frontend_override && ! -e $backend_override && ! -L $backend_override ]] || {
            printf 'Trial or conflicting override already exists; inspect with status.\n' >&2
            exit 1
        }
        if legacy_present; then
            printf 'Legacy runtime trial assets exist; inspect status and run stop before installing the persistent trial.\n' >&2
            exit 1
        fi
        # Match the effective Hyprland-specific or generic config precedence.
        config_source=
        for candidate in \
            "${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal/hyprland-portals.conf" \
            "${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal/portals.conf" \
            /etc/xdg/xdg-desktop-portal/hyprland-portals.conf \
            /etc/xdg/xdg-desktop-portal/portals.conf \
            /usr/share/xdg-desktop-portal/hyprland-portals.conf; do
            if [[ -f $candidate ]]; then
                config_source=$candidate
                break
            fi
        done
        [[ -n $config_source ]] || { printf 'No effective portal configuration found.\n' >&2; exit 1; }
        helper_exec=$(unit_path "$trial_dir/session-helper")
        backend_exec=$(unit_path "$trial_dir/xdg-desktop-portal-hyprland")
        portal_env=$(unit_path "XDG_DESKTOP_PORTAL_DIR=$trial_dir/portals")
        picker_env=$(unit_path "PATH=$trial_dir:/usr/local/bin:/usr/bin")
        "$helper" prepare-environment
        mkdir -p "$(dirname "$trial_dir")"
        mkdir -m 700 "$trial_dir"
        printf '%s\n' "$revision" > "$trial_dir/owned-by-ukvm-trial"
        trap rollback_start EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM
        printf 'preparing\n' > "$trial_dir/state"
        mkdir -p "$trial_dir/portals" "$(dirname "$frontend_override")" "$(dirname "$backend_override")"
        cp "$helper" "$trial_dir/session-helper"
        cp "$build_dir/xdg-desktop-portal-hyprland" "$trial_dir/xdg-desktop-portal-hyprland"
        cp "$build_dir/hyprland-share-picker/hyprland-share-picker" "$trial_dir/hyprland-share-picker"
        chmod 700 "$trial_dir/session-helper" "$trial_dir/xdg-desktop-portal-hyprland" "$trial_dir/hyprland-share-picker"
        cp /usr/share/xdg-desktop-portal/portals/*.portal "$trial_dir/portals/"
        cp "$source_dir/hyprland.portal" "$trial_dir/portals/hyprland.portal"
        cp "$config_source" "$trial_dir/portals/hyprland-portals.conf"
        printf 'Copied portal configuration from %s\n' "$config_source"
        cat > "$trial_dir/frontend.conf" <<EOF
[Unit]
BindsTo=graphical-session.target xdg-desktop-portal-hyprland.service
PartOf=graphical-session.target xdg-desktop-portal-hyprland.service
After=xdg-desktop-portal-hyprland.service
ConditionEnvironment=
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=$portal_env
ExecStart=
ExecStart=:$helper_exec frontend /usr/lib/xdg-desktop-portal
ExecStartPost=:$helper_exec check-frontend
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
EOF
        cat > "$trial_dir/backend.conf" <<EOF
[Unit]
BindsTo=graphical-session.target
PartOf=graphical-session.target
Wants=xdg-desktop-portal.service
ConditionEnvironment=
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
ExecStart=
ExecStart=:$helper_exec backend $backend_exec
ExecStartPost=:$helper_exec check-backend
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=$picker_env
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
EOF
        cp "$trial_dir/frontend.conf" "$frontend_override"
        cp "$trial_dir/backend.conf" "$backend_override"
        owned_trial
        systemctl --user daemon-reload
        systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-hyprland.service
        clear_failures
        # El frontend arranca después del backend y sus comprobaciones de capacidades.
        systemctl --user restart xdg-desktop-portal.service
        portals_active
        "$trial_dir/session-helper" check-backend
        "$trial_dir/session-helper" check-frontend
        printf 'active\n' > "$trial_dir/state"
        trap - EXIT HUP INT TERM
        printf 'Trial active. Verify with ukvm doctor. Roll back: %s stop\n' "$0"
        ;;
    stop)
        restore_portals
        ;;
    status)
        if [[ -f $trial_dir/owned-by-ukvm-trial ]]; then
            printf 'UKVM development portal trial installed (%s): %s\n' "$storage" "$(cat "$trial_dir/owned-by-ukvm-trial")"
            printf 'Last setup/restoration state: %s\n' "$(cat "$trial_dir/state" 2>/dev/null || printf legacy)"
            systemctl --user show xdg-desktop-portal-hyprland.service xdg-desktop-portal.service \
                -p Id -p ActiveState -p SubState -p Result -p MainPID -p NRestarts \
                -p BindsTo -p PartOf -p After -p DropInPaths
            owned_trial || { printf 'Trial state: broken (ownership/configuration mismatch).\n' >&2; exit 1; }
            if [[ $storage == persistent && ( ! -f $frontend_override || ! -f $backend_override || ! -x $trial_dir/xdg-desktop-portal-hyprland || ! -x $trial_dir/hyprland-share-picker ) ]]; then
                printf 'Trial state: broken (persistent integration/assets missing); run stop to restore.\n' >&2
                exit 1
            fi
            if [[ ! -x $trial_dir/session-helper ]]; then
                printf 'Trial state: broken. Legacy/incomplete trial: stop, build UKVM, and start the trial again.\n' >&2
                exit 1
            fi
            phase=$(cat "$trial_dir/state" 2>/dev/null || printf legacy)
            if [[ $phase != active && $phase != legacy ]]; then
                printf 'Trial state: broken (incomplete setup/restoration: %s).\n' "$phase" >&2
                exit 1
            fi
            backend_state=$(systemctl --user show --property=ActiveState --value "${units[0]}")
            frontend_state=$(systemctl --user show --property=ActiveState --value "${units[1]}")
            if [[ $backend_state == inactive && $frontend_state == inactive ]]; then
                printf 'Trial state: inactive (both portal services stopped).\n'
                exit 1
            fi
            if [[ $backend_state != active || $frontend_state != active ]]; then
                printf 'Trial state: broken (backend=%s, frontend=%s).\n' "$backend_state" "$frontend_state" >&2
                exit 1
            fi
            failed=0
            "$trial_dir/session-helper" check-backend || failed=1
            "$trial_dir/session-helper" check-frontend || failed=1
            if (( failed )); then
                printf 'Trial state: broken; not ready for this login. Inspect journalctl --user -u xdg-desktop-portal-hyprland -u xdg-desktop-portal.\n' >&2
                exit 1
            fi
            printf 'Trial state: active. Both portals belong to the current Hyprland session and advertise keyboard/pointer.\n'
        else
            if [[ -e $trial_dir || -L $trial_dir || -e $frontend_override || -e $backend_override || -L $frontend_override || -L $backend_override ]]; then
                printf 'Trial state: broken/unowned assets; refusing automatic cleanup.\n' >&2
                exit 1
            fi
            printf 'No UKVM development portal trial marker. Trial state: not installed.\n'
            systemctl --user show "${units[@]}" -p Id -p LoadState -p ActiveState -p SubState -p Result
            if ! portals_active; then
                printf 'Portal stack inactive/broken; a validated trial start can establish it from this state.\n' >&2
                exit 1
            fi
        fi
        ;;
    *) usage ;;
esac
